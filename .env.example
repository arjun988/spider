# Application
APP_NAME=Spider
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-32-byte-base64-or-fernet-key

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Spider

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=spider
POSTGRES_PASSWORD=spider
POSTGRES_DB=spider
# Use localhost when running Python tools on the host; Compose overrides to service names.
DATABASE_URL=postgresql+asyncpg://spider:spider@localhost:5432/spider
DATABASE_URL_SYNC=postgresql://spider:spider@localhost:5432/spider

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# GitHub App (Phase 2)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_NAME=
FRONTEND_URL=http://localhost:3000
SENTRY_DSN=
# Dev bypass only when APP_ENV=development. Staging/production always force GitHub SSO.
AUTH_DISABLED_IN_DEV=true
# Set true to require JWT/SSO even in development
REQUIRE_AUTH=false

# LLM provider: gemini (default) | litellm
LLM_PROVIDER=gemini

# Gemini (BYOK — configure via admin UI or env for local dev)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=8192

# LiteLLM OpenAI-compatible proxy (docker service on :4000)
# Keep LLM_PROVIDER=gemini for direct Google SDK, or set litellm to route via the proxy.
LITELLM_MASTER_KEY=sk-spider-litellm-dev
LITELLM_SALT_KEY=sk-spider-litellm-salt-dev
LITELLM_DB_PASSWORD=litellm
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=sk-spider-litellm-dev
LITELLM_MODEL=gemini/gemini-2.5-flash
LITELLM_EMBEDDING_MODEL=gemini/text-embedding-004
LITELLM_LOG=INFO
# Admin UI login (http://localhost:4000/ui) — password defaults to master key if unset
UI_USERNAME=admin
UI_PASSWORD=sk-spider-litellm-dev

# Review defaults
REVIEW_AUTO_ENABLED=true
REVIEW_MAX_FILES=50
REVIEW_CONTEXT_LIMIT=20
REVIEW_SEVERITY_THRESHOLD=medium
MONTHLY_BUDGET_USD=100.00

# Sandbox (Phase 5)
SANDBOX_IMAGE=spider-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0

# Repo storage
REPOS_BASE_PATH=/data/repos